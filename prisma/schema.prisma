generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum NetworkType {
  MOBILIS
  OOREDOO
  DJEZZY
  VSAT
}

enum SMSStatus {
  RECEIVED
  READ
  REPLIED
  ARCHIVED
}

enum RechargeStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentMethod {
  MANUAL
  STRIPE
  CRYPTO
  WALLET
}

// User Models
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  phone         String?
  name          String?
  passwordHash  String?
  role          UserRole @default(USER)
  balance       Decimal  @default(0) @db.Decimal(12, 2)
  isBanned      Boolean  @default(false)
  banReason     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  profile       UserProfile?
  phoneNumbers  PhoneNumber[]
  recharges     Recharge[]
  smsMessages   SMSMessage[]
  transactions  Transaction[]
  operations    Operation[]

  @@map("users")
}

model UserProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  avatar             String?
  country            String?
  city               String?
  phoneVerified      Boolean   @default(false)
  twoFactorEnabled   Boolean   @default(false)
  lastLogin          DateTime?
  loginCount         Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// Phone Numbers Management
model PhoneNumber {
  id              String       @id @default(cuid())
  userId          String
  phoneNumber     String
  network         NetworkType
  currentBalance  Decimal      @default(0) @db.Decimal(12, 2)
  operator        String       // e.g., "Mobilis", "Ooredoo"
  status          String       @default("active") // active, inactive, suspended
  displayName     String?      // nickname for the number
  isVerified      Boolean      @default(false)
  lastRecharge    DateTime?
  rechargeCount   Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  recharges       Recharge[]
  smsMessages     SMSMessage[]
  operations      Operation[]

  @@unique([userId, phoneNumber])
  @@index([userId])
  @@map("phone_numbers")
}

// Recharge/Top-up Operations
model Recharge {
  id               String          @id @default(cuid())
  userId           String
  phoneNumberId    String
  amount           Decimal         @db.Decimal(10, 2)
  network          NetworkType
  status           RechargeStatus  @default(PENDING)
  paymentMethod    PaymentMethod   @default(MANUAL)
  paymentProof     String?         // URL to uploaded proof
  description      String?         // Admin notes
  approvedBy       String?         // Admin user ID who approved
  rejectionReason  String?
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  completedAt      DateTime?

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber      PhoneNumber     @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)
  transaction      Transaction?
  logs             RechargeLog[]

  @@index([userId])
  @@index([phoneNumberId])
  @@index([status])
  @@index([createdAt])
  @@map("recharges")
}

model RechargeLog {
  id         String   @id @default(cuid())
  rechargeId String
  action     String   // "created", "approved", "rejected", "completed", etc.
  details    Json?
  createdAt  DateTime @default(now())

  recharge   Recharge @relation(fields: [rechargeId], references: [id], onDelete: Cascade)

  @@map("recharge_logs")
}

// SMS Management
model SMSMessage {
  id             String     @id @default(cuid())
  userId         String
  phoneNumberId  String
  sender         String     // Phone number of SMS sender
  message        String     @db.Text
  status         SMSStatus  @default(RECEIVED)
  isRead         Boolean    @default(false)
  readAt         DateTime?
  replyTo        String?    // ID of SMS being replied to
  replyText      String?    // Reply message if any
  replySentAt    DateTime?
  tags           String[]   // For organizing: ["important", "promotion", etc.]
  ipAddress      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber    PhoneNumber @relation(fields: [phoneNumberId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([phoneNumberId])
  @@index([status])
  @@index([createdAt])
  @@map("sms_messages")
}

// Transactions (Payments & Wallet)
model Transaction {
  id               String          @id @default(cuid())
  userId           String
  rechargeId       String?         @unique
  type             String          // "debit", "credit", "refund"
  amount           Decimal         @db.Decimal(12, 2)
  paymentMethod    PaymentMethod
  status           String          @default("completed") // "pending", "completed", "failed"
  description      String?
  reference        String?         // Payment reference number
  stripePaymentId  String?         // Stripe transaction ID
  balanceBefore    Decimal         @db.Decimal(12, 2)
  balanceAfter     Decimal         @db.Decimal(12, 2)
  metadata         Json?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  recharge         Recharge?       @relation(fields: [rechargeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("transactions")
}

// Operations History (Audit Trail)
model Operation {
  id               String   @id @default(cuid())
  userId           String
  phoneNumberId    String?
  type             String   // "recharge", "sms_sent", "sms_received", "balance_update", etc.
  action           String   // "created", "approved", "rejected", etc.
  amount           Decimal? @db.Decimal(12, 2)
  description      String?
  status           String   @default("success") // "success", "failed", "pending"
  oldValue         Json?    // Previous value
  newValue         Json?    // New value
  ipAddress        String?
  userAgent        String?
  metadata         Json?
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber      PhoneNumber? @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([phoneNumberId])
  @@index([type])
  @@index([createdAt])
  @@map("operations")
}

// Admin Settings & Configuration
model AdminSettings {
  id                  String   @id @default(cuid())
  rechargeCommission  Decimal  @default(5) @db.Decimal(5, 2)  // Percentage
  minRechargeAmount   Decimal  @default(500) @db.Decimal(10, 2)
  maxRechargeAmount   Decimal  @default(100000) @db.Decimal(10, 2)
  maintenanceMode     Boolean  @default(false)
  maintenanceMessage  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("admin_settings")
}

// Subscription Plans (Optional)
model SubscriptionPlan {
  id          String   @id @default(cuid())
  name        String   // "Basic", "Pro", "Premium"
  description String?
  price       Decimal  @db.Decimal(10, 2)
  duration    Int      // Days
  features    String[] // JSON array of features
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id             String   @id @default(cuid())
  userId         String
  planId         String
  startDate      DateTime
  endDate        DateTime
  autoRenew      Boolean  @default(true)
  status         String   @default("active") // "active", "expired", "cancelled"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation?
  plan           SubscriptionPlan @relation(fields: [planId], references: [id])

  @@unique([userId, planId])
  @@map("subscriptions")
}
